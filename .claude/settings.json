{
  "model": "claude-opus-4-6",
  "effortLevel": "max",
  "env": {
  },
  "permissions": {
    "allow": [
      "Bash(cd * && cmake *)",
      "Bash(cd * && git add *)",
      "Bash(git add *)",
      "Bash(cd * && *)",
      "Bash(cd * && gh *)",
      "Bash(gh *)",
      "Bash(cmake *)",
      "Bash(*)",
      "PowerShell(gh *)",
      "PowerShell(git add *)",
      "PowerShell(cmake --build *)",
      "PowerShell(cmake --build * | *)",
      "PowerShell(cmake --build * 2>&1 | *)",
      "PowerShell(cmake *)",
      "PowerShell(ctest *)",
      "PowerShell(ctest * | *)",
      "PowerShell(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "additionalDirectories": [
      "d:\\Lessons\\Grants\\2027\\GDM\\tests\\unit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git add .)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "Bash(git add -A*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "PowerShell(git add .)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "PowerShell(git add -A*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(cmake --build*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/warn-on-compiler-warnings.sh"
          },
          {
            "type": "command",
            "if": "PowerShell(cmake --build*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/warn-on-compiler-warnings.sh"
          }
        ]
      }
    ]
  },
  "autoCompact": true,
  "readOnlyCommands": [
    "ls",
    "cat",
    "head",
    "tail",
    "grep",
    "find",
    "echo"
  ],
  "context": {
    "exclude": [
      "build/",
      "build-vscode/",
      "out/",
      ".vs/",
      "vault/GDM/.obsidian/",
      "example_files/",
      "HydroSolver/AMGSolver/amgcl/",
      "vault/GDM/sessions/"
    ]
  }
}
