		const char* coord,
		const char* poro,
		const char* soil,
		const char* actnum,
		const char* so,
		const char* vol,
		float* xstart,
		float* ystart,
		float* dx,
		float* dy,
		std::vector<std::vector<std::vector<float>>>* plrs,
		std::vector<float>* b_sat,
		float* average,
		float* b_average,
		float density,
		float xshift,
		float yshift);
