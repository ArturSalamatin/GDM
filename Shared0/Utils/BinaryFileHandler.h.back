		/// <summary>
		/// Накопленная закачаная вода
		/// </summary>
		double WaterUpload = 0;
		/// <summary>
		/// Нефть за последний месяц
		/// </summary>
		double CurrentOil = 0;
		/// <summary>
		/// Вода за последний месяц
		/// </summary>
		double CurrentWater = 0;
		/// <summary>
		/// Закачанная вода за последний месяц
		/// </summary>
		double CurrentWaterUpload = 0;
		/// <summary>
		/// Суммарное отработанное время
		/// </summary>
		int WorkedTime = 0;
		/// <summary>
		/// Суммарное время сбора
		/// </summary>
		int CollectTime = 0;
		/// <summary>
		/// Отработанное время за последний месяц
		/// </summary>
		int CurrentWorkedTime = 0;
		/// <summary>
		/// Время сбора за последний месяц
		/// </summary>
		int CurrentCollectTime = 0;
		/// <summary>
		/// Дебет за последний месяц
		/// </summary>
		double CurrentDebit = 0;
		/// <summary>
		/// Обводненность за последний месяц
		/// </summary>
		double CurrentWaterCut = 0;
#ifdef ONLY_UP_TO_2000
		/// <summary>
		/// считает колличество месяцев до указанной даты. Устанавливается только для методов с временным ограническием
		/// </summary>
		int cntr_after_set_date = 0;
		float debet_za_2_goda = 0;
		float obvodnennost_za_2_goda = 0;
#endif
#ifdef WRITE_WATERCUT_AT_TIME
		/// <summary>
		/// Время, нефть, обводненность, вода, время работы
		/// </summary>
		std::vector<std::tuple<int, double, double, double, int>> TimeOilWaterCut;
#endif
	};
	static struct Value //��������� ��� �������� ������������� ������
	{
		double val = -1; //�������� �������� ������ ��� double
		std::string sValue; //��������� ��� ������
	};
	
	/// <summary>
	/// Считывает название скважины и guid и файла Holes.bin
	/// </summary>
	/// <param name="path">Путь до файла Holes.bin. Пример: C:\User\Aabvc\тут гуид папки со скважинами\Holes.bin</param>
	/// <returns>Вектор, содержащий данные по скважинам. 0 индекс - имя, 1 - guid
	/// Пример:
	/// 0 - 10001  1 - guid
	/// Нулевой вектор в случае неудачи
	/// </returns>
	static std::vector < std::vector<std::string> > ReadHoles(const char* path);
	/// <summary>
	/// Возвращает вектор с координатами скважины из .WellIntersection
	/// </summary>
	/// <param name="path">>Путь до файла .WellIntersection Пример: C:\User\Aabvc\тут гуид папки со скважинами\гуид.WellIntersection</param>
	/// <returns>Двумерный вектор, где 0 - Х, 1 - Y
	/// Нулевой вектор в случае неудачи
	/// </returns>
	static std::vector<double> ParseWellCoordinates(const char* path);
	/// <summary>
	/// Считывает рабочую зону из файла проекта, упорядоченный и замкнутный
	/// </summary>
	/// <param name="path">Путь до файла проекта Пример: C:\User\Aabvc\Project.bop</param>
	/// <returns>Вектор, содержащий координаты рабочей зоны, отсортированные и замкнутые
	/// Нулевой вектор в случае неудачи</returns>
	static std::vector<std::vector<double>> ReadZoneFromProject(const char* path);
	/// <summary>
	/// Возвращает guid папки с вектором из файла проекта
	/// </summary>
	/// <param name="path">Путь до файла проекта Пример: C:\User\Aabvc\Project.bop</param>
	/// <returns>guid папки со скважинами
	/// </returns>
	static std::string GetWellsGuidFromProject(const char* path);
	/// <summary>
	/// Возвращает guid папки с моделью из файла проекта
	/// </summary>
	/// <param name="path">Путь до файла проекта Пример: C:\User\Aabvc\Project.bop</param>
	/// <returns>guid папки с моделью</returns>
	static std::string GetGridcellGuidFromProject(const char* path);
	static std::string GetMapsGuidFromProject(const char* path);
	/// <summary>
	/// Считывает информацию о моделе
	/// </summary>
	/// <param name="path">Путь до файла Model.bin Пример: C:\User\Aabvc\тут гуид папки с моделями\Model.bin</param>
	/// <param name="xshift">Указатель на переменную, в которую будет записано значение смешения по x</param>
	/// <param name="yshifth">Указатель на переменную, в которую будет записано значение смешения по y</param>
	/// <returns>Карта: Тип файла:Guid
	/// Пример: 
	/// SOIL : гуид
	/// COORD : гуид
	/// и т.д.
	/// Нулевая карта в случае неудачи
	/// </returns>
	static std::map<std::string, std::string> ReadGRDECLModels(const char* path, double* xshift, double* yshifth);
	static std::map<std::string, std::string> ReadGRDECLModels(const char* path, double* xshift, double* yshifth, int* nx, int *ny, int *nz);
	/// <summary>
	/// Функция, считывающая модель в 2д формате
	/// </summary>
	/// <param name="coord">Путь до файла COORD</param>
	/// <param name="poro">Путь до файла PORO</param>
