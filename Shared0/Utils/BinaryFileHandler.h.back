		std::string path_d0,
		std::string path_d1a,
		std::string path_d1b1,
		std::string path_d1b2,
		std::string path_d1b3,
		std::string path_v,
		std::string path_g1,
		std::string path_g2_3,
		std::string path_gd,
		IrapGridMapInfo& info
	);
	static std::vector < std::tuple<double, double, double >> ParseArtemFile(std::string path);
	static std::vector<std::vector<std::string>> ParseCsv(std::string path);
	static std::vector<std::vector<std::string>> ParseSeparatedData(std::string path, char separator);
	static std::vector<std::vector<std::string>> ParseCsvMP(std::string path);
};


class BinaryFileWrite
{
public:
	static struct MapInfo
	{
		//GUID MapGuid; //guid карты
		std::string MapsName = ""; //Имя карты
		std::string MapsShortName = ""; //Имя короткое
		std::string GeometryFile = ""; //Имя файла геометрии
		std::string PointsFile = ""; //Имя файла с параметрами скважин
		std::string MapsUnit = ""; //Единицы измерения
		std::string MapsFileName = ""; //Имя карты
		int MDimension = 2; //Размерность пространства карт
		uint8_t MapsFileId = 0;
		size_t hash = 0;
	};
	/// <summary>
	/// Инициализирует механизм записи карт
	/// </summary>
	/// <param name="path">Путь до директории, куда необходимо писать файл c концевым \</param>
	/// <param name="sign">Подпись файлов, должна иметь размер 16 символов</param>
	/// <param name="mapsini">Путь до файла Maps.ini</param>
	BinaryFileWrite(std::string path, std::string sign, std::string mapsini);
	~BinaryFileWrite();
	/// <summary>
	/// Добавляет данную карту в индекс, генерирует для нее Гуид и устанавливает дату
	/// </summary>
	/// <param name="MapsName">Имя карты</param>
	/// <param name="MapsUnit">Едицины измерения</param>
	/// <returns>id добавленной карты</returns>
	int CreateMap(
		std::string MapName,
		std::string ShortMapName,
		std::string MapsUnit,
		std::string GeometryFile,
		std::string PointsFile,
		int dimension);
	/// <summary>
	/// Создает файл описания, записывает его и карты с сигнатурами на диск
	/// <param name="type">Формат заголовочного файла - csv/ini. В текущем билде используется только ini!</param>
	/// </summary>
	void CreateMaps(std::string type);
	/// <summary>
	/// Пишет в указанную карту в бинарном виде
	/// </summary>
	/// <typeparam name="T">Любой числовой тип</typeparam>
	/// <param name="value">Значение на запись</param>
	/// <param name="MapId">В какую карту писать</param>
	template < typename T > void WriteToMap(T value, int MapId);
	/// <summary>
	/// Возвращает путь до папки проекта с \ на конце
	/// </summary>
	/// <param name="project_path">Путь до файла проекта</param>
	/// <returns>Путь до папки проекта</returns>
	static std::string GetProjectDirectory(std::string project_path);

	void WriteMaps();

	std::vector < std::vector<char>> MapsBuffer;
private:
	std::vector< MapInfo> Maps;
	std::string Path;
	std::string MapsIniPath;
	std::string Sign;

	std::string ToString(GUID* guid);
};

template<typename T>
inline void BinaryFileWrite::WriteToMap(T value, int MapId)
{
	/*char buffer[37];
	std::string guid = ToString(&Maps[MapId].MapGuid);
	std::ofstream mps(Path + guid, std::ios::binary | std::ios::app);
	if (mps.is_open())
	{
		mps.write(reinterpret_cast<const char*> (&value), sizeof(T));
		mps.close();
	}*/
	
	int rmsize = sizeof(T);
	char* test = reinterpret_cast<char*>(&value);
	for (int i = 0; i < rmsize; i++)
		MapsBuffer[MapId].push_back(*(test + i));
}
