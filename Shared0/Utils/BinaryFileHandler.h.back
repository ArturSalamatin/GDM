	/// <param name="actnum">Путь до файла ACTNUM</param>
	/// <param name="so">Путь до файла SOIL1</param>
	/// <param name="vol">Путь до файла VOLUME</param>
	/// <param name="xstart">Указатель на переменную, в которую будет записано начало координат модели по Х</param>
	/// <param name="ystart">>Указатель на переменную, в которую будет записано начало координат модели по Y</param>
	/// <param name="dx">>Указатель на переменную, в которую будет записано средний шаг сетки по х (Нужен для грубых расчетов)</param>
	/// <param name="dy">Указатель на переменную, в которую будет записано средний шаг сетки по у(Нужен для грубых расчетов)</param>
	/// <param name="plrs">Указатель на массив, в который будут записаны векторы-направляющие сетки</param>
	/// <param name="b_sat">Указатель на массив, в который будут записаны начальные геологические запасы (хз почему я так назвал)</param>
	/// <param name="average">Переменная, в которую будет записаны средние запасы на ячейку по текущим запасам</param>
	/// <param name="b_average">Переменная, в которую будет записны средние запасы на ячейку по начальным геол. запасам</param>
	/// <param name="density">Плотность нефти</param>
