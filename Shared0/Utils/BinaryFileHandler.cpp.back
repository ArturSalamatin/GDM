		if (sign == "KPFUBOIL  GRDECL") //проверяем сигнатуру
		{
			//загружаем смешение и кол-ва
			memcpy_s(nx, 4, &file[20], 4);
			memcpy_s(ny, 4, &file[24], 4);
			memcpy_s(nz, 4, &file[28], 4);
			memcpy_s(xshift, 8, &file[32], 8);
			memcpy_s(yshifth, 8, &file[40], 8);
			//загружаем guid
			std::vector<char> Buffer;
			std::vector<std::string> sBuffer;
			for (int i = 48; i < file.size(); i++)
			{
				if (file[i] != '|')
				{
					Buffer.push_back(file[i]); //все символы собираем в один массив
				}
				else {
					sBuffer.push_back(std::string(Buffer.begin(), Buffer.end())); //на разделителе парсим строку
					Buffer.clear();
					if (sBuffer.size() == 2) //если строка собралась, то добавляем её в выходной массив
					{
						out.insert({ sBuffer[0], sBuffer[1] });

						sBuffer.clear();
					}
				}
			}
			sBuffer.push_back(std::string(Buffer.begin(), Buffer.end())); //для последней строки
			out.insert({ sBuffer[0], sBuffer[1] });
			return out;
		}
	}
	return out;
}



std::vector < std::vector<std::string> > BinaryFileRead::ReadHoles(const char* path)
{
	auto file = Read(path); //читаем файл
	//проверяем сигнатуру
	if (file.size() > 0)
	{
		char* sign = new char[17]; //17 т.к. 17 байт будет \0 концевым чаром
		sign[16] = '\0';
		memcpy_s(sign, 16, &file[0], 16);
		std::string sg(sign);
		if (sg == "KPFUBOIL   HOLES")
		{
			std::vector < std::vector<std::string> > out;
			std::vector<std::string> outt;
			std::vector<char> WellId;
			for (auto i = file.begin() + 20; i < file.end(); i++)
			{
				if (*i != '|') //собираем все между разделителем |
				{
					WellId.push_back(*i);
				}
				else {
					WellId.push_back('\0');
					std::string str(&WellId[0]);
					outt.push_back(str);
					WellId.clear();
					if (outt.size() == 2) //данные хранятся парами, если размер = 2, то пара собрана
					{
						out.push_back(outt);
						outt.clear();
					}
				}
			}
			//последняя строка не имеет разделителя, все что осталось должно быть последним id
			WellId.push_back('\0');
			std::string str(&WellId[0]);
			outt.push_back(str);
			out.push_back(outt);
			return out;
		}
	}
	return std::vector < std::vector<std::string> >();
}

std::vector<double> BinaryFileRead::ParseWellCoordinates(const char* path)
{
	auto file = Read(path); //считываем WellIntersection
	if (file.size() > 0) //проверка на неоткрытый файл
	{
		char* sign = new char[17]; //17 т.к. 17 байт будет \0 концевым чаром
		sign[16] = '\0';
		memcpy_s(sign, 16, &file[0], 16);
		std::string sg(sign);
		if (sg == "KPFUBOIL    HOLE")//Проверяем сигнатуру
		{
			std::vector<Value> out;
			int header_lenght = 0;
			memcpy_s(&header_lenght, 4, &file[16], 4);
			int line_size = header_lenght / 5; //получаем кол-во элементов в одной строке
			std::string hdrs(&file[20], line_size); //получаем заголовок
			int line_weight = 0; //размер всей строки с данными
			std::vector<int> sizes;
			for (int i = 0; i < line_size; i++) //перебираем заголовок, собираем полный размер всей строки с данными
			{
				int element_size = 0;
				memcpy_s(&element_size, 4, &file[20 + line_size + i * 4], 4);
				line_weight += element_size;
				sizes.push_back(element_size);
			}
			//перебираем массив
			for (auto i = 20 + header_lenght; i < file.size(); i += line_weight)
			{
				int k = 0;
				while (k < line_size)
				{
					Value val;
					switch (*(hdrs.c_str() + k))//разбираем строку по буквам и парсим в соответсвие
					{
					case 'F': //float
					{
						float res = 0;
						memcpy_s(&res, sizes[k], &file[i], sizes[k]);
						val.val = res;
						i += sizes[k]; //двигаем каретку дальше
						break;
					}
					case 'D': //double
					{
						memcpy_s(&val.val, sizes[k], &file[i], sizes[k]);
						i += sizes[k]; //двигаем каретку дальше
						break;
					}
					case 'I': //int
					{
						int res = 0;
						memcpy_s(&res, sizes[k], &file[i], sizes[k]);
						val.val = res;
						i += sizes[k]; //двигаем каретку дальше
						break;
					}
					case 'A': //time int
					{
						int res = 0;
						memcpy_s(&res, sizes[k], &file[i], sizes[k]);
						val.val = res;
						i += sizes[k]; //двигаем каретку дальше
						break;
					}
					case 'C': //???
					{
						std::string ot(&file[i], sizes[k]);
						val.sValue = ot;
						i += sizes[k]; //двигаем каретку дальше
						break;
					}
					}
					out.push_back(val);
					k++;
				}
			}
			std::vector<double> toOut;
			toOut.push_back(out[1].val); //сохраняем x и y
			toOut.push_back(out[2].val);
			return toOut;
		}
	}
	return std::vector<double>();
}

std::vector<char> BinaryFileRead::Read(const char* path)
{
	std::ifstream input(path, std::ios::binary);
	if (input.is_open())
	{
		std::vector<char> bytes(
			(std::istreambuf_iterator<char>(input)),
			(std::istreambuf_iterator<char>()));
		input.close();
		return bytes;
	}
	else {
		return std::vector<char>();
	}
}

int compare(const void* X, const void* Y)
{
	std::vector<double>* x = (std::vector<double>*)X;
	std::vector<double>* y = (std::vector<double>*)Y;
	if (abs(x->at(0) - y->at(0)) < 1e-1)
		return 0;
	if (x->at(0) > y->at(0))
		return 1;
	if (x->at(0) < y->at(0))
		return -1;
}
int compareY(const void* X, const void* Y)
{
	std::vector<double>* x = (std::vector<double>*)X;
	std::vector<double>* y = (std::vector<double>*)Y;
	if (abs(x->at(1) - y->at(1)) < 1e-1)
		return 0;
	if (x->at(1) > y->at(1))
		return 1;
	if (x->at(1) < y->at(1))
		return -1;
}


