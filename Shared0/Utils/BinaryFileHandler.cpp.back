#include "BinaryFileHandler.h"


//#define SHOWVOLUME

BinaryFileRead::MERResult BinaryFileRead::GetMERData(const char* MER) {
	auto file = Read(MER);

	double out_oil = 0;
	double out_water = 0;
	double out_upl_water = 0;

	int out_time = 0;
	int collection_time = 0;
	int last_upload_time = 0;
	int out_last_worked_time = 0;
	int out_last_collect_time = 0;


	double out_last_debit = 0;
	double out_last_watercut = 0;
	double out_last_upld_water = 0;
	double out_last_water = 0;
	double out_last_oil = 0;
#ifdef WRITE_WATERCUT_AT_TIME
	std::vector<std::tuple<int, double, double, double, int>> date_oil_watercut;
#endif
	int time = 0;

	if (file.size() > 0)
	{
		std::string sign(&file[0], 16);
		if (sign == "KPFUBOIL    HOLE") //У НЕФТИ 9 ИНДЕКС, ВОДЫ 10, У ВРЕМЕНИ 6, У ВРЕМЕНИ СБОРА 7, 20 - У ЗАКАЧИВАЕМОЙ ВОДЫ
		{
			//получаем колво элементов
			int header_Lenght = 0;
			memcpy_s(&header_Lenght, 4, &file[16], 4);
			int line_size = header_Lenght / 5;
			std::string types(&file[20], line_size);
			//получаем размеры
			std::vector<int> sizes;

			int line_bytes_size = 0;
			int size_up_to_9 = 0;
			int size_up_to_6 = 0;

			for (int i = 0; i < line_size; i++)
			{
				int size = 0;
				memcpy_s(&size, 4, &file[20l + line_size + i * 4], 4); //+line_size т.к. мы считали только тексовый зщаголовок
				sizes.push_back(size); //сохраняем размеры
				line_bytes_size += size;
				if (i < 9)
					size_up_to_9 += size;
				if (i < 6)
					size_up_to_6 += size;
			}
			//парсим строки

			for (long i = 20 + header_Lenght; i < file.size(); i += line_bytes_size)
			{
				double last_oil = 0;
				double last_water = 0;
				double last_worked_time = 0;
				double last_upldwater = 0;
				double last_colltime = 0;

				uint8_t* o_buffer = new uint8_t[sizes[9]];
				uint8_t* w_buffer = new uint8_t[sizes[10]];
				uint8_t* upd_buffer = new uint8_t[sizes[20]];

				uint8_t* t_buffer = new uint8_t[sizes[6]];
				uint8_t* t_collect_buffer = new uint8_t[sizes[7]];

				uint8_t* tm_buffer = new uint8_t[sizes[0]];



				memcpy_s(t_buffer, sizes[6], &file[i + size_up_to_6], sizes[6]); //время работы
				memcpy_s(t_collect_buffer, sizes[7], &file[i + size_up_to_6 + sizes[6]], sizes[7]); //время сбора

				memcpy_s(o_buffer, sizes[9], &file[i + size_up_to_9], sizes[9]); //нефть
				memcpy_s(w_buffer, sizes[10], &file[i + size_up_to_9 + sizes[9]], sizes[10]); //вода
				memcpy_s(upd_buffer, sizes[20], &file[i + line_bytes_size - sizes[20]], sizes[20]); //вода

				memcpy_s(tm_buffer, sizes[0], &file[i], sizes[0]); //дата
				//нефть
				if (types[9] == 'F')
				{
					float foil = 0;
					memcpy_s(&foil, sizes[9], o_buffer, sizes[9]);
					out_oil += foil; //суммируем добычу
					last_oil = foil;
				}
				if (types[9] == 'D')
				{
					double foil = 0;
					memcpy_s(&foil, sizes[9], o_buffer, sizes[9]);
					out_oil += foil; //суммируем добычу
					last_oil = foil;
				}
				//вода
				if (types[10] == 'F')
				{
					float fwtr = 0;
					memcpy_s(&fwtr, sizes[10], w_buffer, sizes[10]);
					out_water += fwtr; //суммируем добычу воды
					last_water = fwtr;


				}
				if (types[10] == 'D')
				{
					double fwtr = 0;
					memcpy_s(&fwtr, sizes[10], w_buffer, sizes[10]);
					out_water += fwtr; //суммируем добычу воды
					last_water = fwtr;
				}
				//закаченная вода
				if (types[20] == 'F')
				{
					float foil = 0;
					memcpy_s(&foil, sizes[20], upd_buffer, sizes[20]);
					out_upl_water += foil; //суммируем добычу
					last_upldwater = foil;
				}
				if (types[20] == 'D')
				{
					double foil = 0;
					memcpy_s(&foil, sizes[20], upd_buffer, sizes[20]);
					out_upl_water += foil; //суммируем добычу
					last_upldwater = foil;
				}
				//время работы
				if (types[6] == 'I') //время работы
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[6], t_buffer, sizes[6]);
					out_time += ftm;
					last_worked_time = ftm;
				}
				//время сбора
				if (types[7] == 'I') //время сбора
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[7], t_collect_buffer, sizes[7]);
					collection_time += ftm;
					last_colltime = ftm;
				}
				//дата
				if (types[0] == 'A')
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[0], tm_buffer, sizes[0]);
#ifdef WRITE_WATERCUT_AT_TIME
					int wwat_time = ftm;
					double wwat_oil_at_time = last_oil;
					double wwat_watercut = 0;
					if (last_oil != 0 && last_water != 0)
						wwat_watercut = last_water / (double)(last_water + last_oil) * 100;
					else {
						if (last_water == 0 && last_oil != 0)
							wwat_watercut = 0;
						if(last_water != 0 && last_oil == 0)
							wwat_watercut = 100;
						if (last_water == 0 && last_oil == 0)
							wwat_watercut = 0;
					}
					date_oil_watercut.push_back(std::make_tuple( wwat_time , wwat_oil_at_time, wwat_watercut, last_water, last_worked_time));
#endif
					if (ftm > time) //эксель хранит кол-во дней прошедших с 1900 года. Большое число репрезентует самую последнюю дату
					{
						time = ftm;
						if (last_worked_time != 0)
							out_last_debit = last_oil / last_worked_time; //запоминаем текущий дебет
						else
							out_last_debit = 0;
						if (last_water + last_oil != 0) //запоминаем текущую обводненность
							out_last_watercut = last_water / (last_water + last_oil);
						else
							out_last_watercut = 0;
						//запоминаем последную закаченную воду
						out_last_upld_water = last_upldwater;
						out_last_worked_time = last_worked_time;
						out_last_collect_time = last_colltime;
						out_last_water = last_water;
						out_last_oil = last_oil;
					}
				}



				delete[]o_buffer;
				delete[]w_buffer;
				delete[]t_buffer;
				delete[]tm_buffer;
				delete[]t_collect_buffer;
			}

		}
		MERResult out;

		out.Oil = out_oil;
		out.Water = out_water;
		out.WaterUpload = out_upl_water;
		out.CurrentOil = out_last_oil;
		out.CurrentWater = out_last_water;
		out.CurrentWaterUpload = out_last_upld_water;

		out.WorkedTime = out_time;
		out.CollectTime = collection_time;
		out.CurrentWorkedTime = out_last_worked_time;
		out.CurrentCollectTime = out_last_collect_time;

		out.CurrentDebit = out_last_debit;
		out.CurrentWaterCut = out_last_watercut;
		//сохраняем обводненности и времена для них	
#ifdef WRITE_WATERCUT_AT_TIME
		out.TimeOilWaterCut = date_oil_watercut;
#endif
		return out;
	}
	return MERResult();
}
#ifdef ONLY_UP_TO_2000
BinaryFileRead::MERResult BinaryFileRead::GetMERData(const char* MER, int lasttime) {
	auto file = Read(MER);

	double out_oil = 0;
	double out_water = 0;
	double out_upl_water = 0;

	int out_time = 0;
	int collection_time = 0;
	int last_upload_time = 0;
	int out_last_worked_time = 0;
	int out_last_collect_time = 0;


	double out_last_debit = 0;
	double out_last_watercut = 0;
	double out_last_upld_water = 0;
	double out_last_water = 0;
	double out_last_oil = 0;

	double deb_2_goda = 0;
	double obv_2_goda = 0;
	int deb_2_count = 0;
	int obv_2_count = 0;


	int time = 0;
#ifdef WRITE_WATERCUT_AT_TIME
	std::vector<int> watercut_time;
	std::vector<double> watercut;
#endif
	if (file.size() > 0)
	{
		std::string sign(&file[0], 16);
		MERResult out;
		if (sign == "KPFUBOIL    HOLE") //У НЕФТИ 9 ИНДЕКС, ВОДЫ 10, У ВРЕМЕНИ 6, У ВРЕМЕНИ СБОРА 7, 20 - У ЗАКАЧИВАЕМОЙ ВОДЫ
		{
			//получаем колво элементов
			int header_Lenght = 0;
			memcpy_s(&header_Lenght, 4, &file[16], 4);
			int line_size = header_Lenght / 5;
			std::string types(&file[20], line_size);
			//получаем размеры
			std::vector<int> sizes;

			int line_bytes_size = 0;
			int size_up_to_9 = 0;
			int size_up_to_6 = 0;

			for (int i = 0; i < line_size; i++)
			{
				int size = 0;
				memcpy_s(&size, 4, &file[20l + line_size + i * 4], 4); //+line_size т.к. мы считали только тексовый зщаголовок
				sizes.push_back(size); //сохраняем размеры
				line_bytes_size += size;
				if (i < 9)
					size_up_to_9 += size;
				if (i < 6)
					size_up_to_6 += size;
			}
			//парсим строки

			for (long i = 20 + header_Lenght; i < file.size(); i += line_bytes_size)
			{
				double last_oil = 0;
				double last_water = 0;
				double last_worked_time = 0;
				double last_upldwater = 0;
				double last_colltime = 0;

				uint8_t* o_buffer = new uint8_t[sizes[9]];
				uint8_t* w_buffer = new uint8_t[sizes[10]];
				uint8_t* upd_buffer = new uint8_t[sizes[20]];

				uint8_t* t_buffer = new uint8_t[sizes[6]];
				uint8_t* t_collect_buffer = new uint8_t[sizes[7]];

				uint8_t* tm_buffer = new uint8_t[sizes[0]];



				memcpy_s(t_buffer, sizes[6], &file[i + size_up_to_6], sizes[6]); //время работы
				memcpy_s(t_collect_buffer, sizes[7], &file[i + size_up_to_6 + sizes[6]], sizes[7]); //время сбора

				memcpy_s(o_buffer, sizes[9], &file[i + size_up_to_9], sizes[9]); //нефть
				memcpy_s(w_buffer, sizes[10], &file[i + size_up_to_9 + sizes[9]], sizes[10]); //вода
				memcpy_s(upd_buffer, sizes[20], &file[i + line_bytes_size - sizes[20]], sizes[20]); //вода

				memcpy_s(tm_buffer, sizes[0], &file[i], sizes[0]); //дата
				//дата
				int crrnt_time = 0;
				if (types[0] == 'A')
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[0], tm_buffer, sizes[0]);
					crrnt_time = ftm;
				}

				//нефть
				if (types[9] == 'F')
				{
					float foil = 0;
					memcpy_s(&foil, sizes[9], o_buffer, sizes[9]);
					out_oil += foil; //суммируем добычу
					last_oil = foil;
				}
				if (types[9] == 'D')
				{
					double foil = 0;
					memcpy_s(&foil, sizes[9], o_buffer, sizes[9]);
					out_oil += foil; //суммируем добычу
					last_oil = foil;
				}
				//вода
				if (types[10] == 'F')
				{
					float fwtr = 0;
					memcpy_s(&fwtr, sizes[10], w_buffer, sizes[10]);
					out_water += fwtr; //суммируем добычу воды
					last_water = fwtr;
				}
				if (types[10] == 'D')
				{
					double fwtr = 0;
					memcpy_s(&fwtr, sizes[10], w_buffer, sizes[10]);
					out_water += fwtr; //суммируем добычу воды
					last_water = fwtr;
				}
				//закаченная вода
				if (types[20] == 'F')
				{
					float foil = 0;
					memcpy_s(&foil, sizes[20], upd_buffer, sizes[20]);
					out_upl_water += foil; //суммируем добычу
					last_upldwater = foil;
				}
				if (types[20] == 'D')
				{
					double foil = 0;
					memcpy_s(&foil, sizes[20], upd_buffer, sizes[20]);
					out_upl_water += foil; //суммируем добычу
					last_upldwater = foil;
				}
				//время работы
				if (types[6] == 'I') //время работы
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[6], t_buffer, sizes[6]);
					out_time += ftm;
					last_worked_time = ftm;
				}
				//время сбора
				if (types[7] == 'I') //время сбора
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[7], t_collect_buffer, sizes[7]);
					collection_time += ftm;
					last_colltime = ftm;
				}
				//дата
				if (types[0] == 'A')
				{
					int ftm = 0;
					memcpy_s(&ftm, sizes[0], tm_buffer, sizes[0]);
#ifdef WRITE_WATERCUT_AT_TIME
					watercut_time.push_back(ftm);
					if (last_oil != 0 && last_water != 0)
						watercut.push_back(last_water / (double)(last_water + last_oil) * 100);
					else
						watercut.push_back(0);
#endif
					if (ftm > time) //эксель хранит кол-во дней прошедших с 1900 года. Большое число репрезентует самую последнюю дату
					{
						time = ftm;
						if (last_worked_time != 0)
							out_last_debit = last_oil / last_worked_time; //запоминаем текущий дебет
						else
							out_last_debit = 0;
						if (last_water + last_oil != 0) //запоминаем текущую обводненность
							out_last_watercut = last_water / (last_water + last_oil);
						else
							out_last_watercut = 0;
						//запоминаем последную закаченную воду
						out_last_upld_water = last_upldwater;
						out_last_worked_time = last_worked_time;
						out_last_collect_time = last_colltime;
						out_last_water = last_water;
						out_last_oil = last_oil;
					}
				}

				if (crrnt_time <= lasttime) //собираем данные только по скважинам для которых есть отчет раньше этой даты
				{
					out.cntr_after_set_date++;
				}
				else { //собираем дебет и обв за 2 года
					if (crrnt_time >= lasttime && crrnt_time <= lasttime + 365 * 20) //+2 года от lastdate
					{
						if (last_worked_time != 0)
						{
							deb_2_goda += last_oil / (double)last_worked_time * 24;
							deb_2_count++;
						}
						if (last_oil + last_water != 0)
						{
							obv_2_goda += last_water / (double)(last_oil + last_water);
							obv_2_count++;
						}
					}
				}

				delete[]o_buffer;
				delete[]w_buffer;
				delete[]t_buffer;
				delete[]tm_buffer;
				delete[]t_collect_buffer;
			}

		}


		out.Oil = out_oil;
		out.Water = out_water;
		out.WaterUpload = out_upl_water;
		out.CurrentOil = out_last_oil;
		out.CurrentWater = out_last_water;
		out.CurrentWaterUpload = out_last_upld_water;

		out.WorkedTime = out_time;
		out.CollectTime = collection_time;
		out.CurrentWorkedTime = out_last_worked_time;
		out.CurrentCollectTime = out_last_collect_time;

		out.CurrentDebit = out_last_debit;
		out.CurrentWaterCut = out_last_watercut;
		if (deb_2_count != 0)
			out.debet_za_2_goda = deb_2_goda / (double)deb_2_count;
		if (obv_2_count != 0)
			out.obvodnennost_za_2_goda = obv_2_goda / (double)obv_2_count;

#ifdef WRITE_WATERCUT_AT_TIME
		//сохраняем обводненности и времена для них		
		out.watercut_list = watercut;
		out.watercut_time_list = watercut_time;
#endif
		return out;
	}
	return MERResult();
}
#endif
std::vector < std::vector<float>>  BinaryFileRead::ReadStock(
	const char* coord, //обязательный путь
	const char* poro, //обязательный
	const char* soil, //или soil или so
	const char* actnum, //необязательно 
	const char* so, //или soil или so
	const char* vol, //обязательно
	float* xstart,
	float* ystart,
	float* dx,
	float* dy,
	std::vector<std::vector<std::vector<float>>>* plrs,
	std::vector<float>* b_sat,
	float* average,
	float* b_average,
	float density,
	float xshift,
	float yshift)
{
	//auto file = Read(coord);
	auto filesize = GetFileSize(std::string(coord));
	if (filesize > 0)
	{
		BinaryFileRead filereader;
		filereader.OpenFile(coord);
		std::string sign(filereader.Read(0, 16), 16);
		if (sign == "KPFUBOIL    GRID") //проверяем 
		{
			std::vector<std::vector<std::vector<float>>> pillars; //напрявляющие
			//получаем размеры
			int xc = 0;
			int yc = 0;
			int zc = 0;
			memcpy_s(&xc, 4, filereader.Read(20, 4), 4);
			memcpy_s(&yc, 4, filereader.Read(24, 4), 4);
			memcpy_s(&zc, 4, filereader.Read(28, 4), 4);
			for (int i = 32; i < filesize; i += 24)
			{
				float x = 0;
				float y = 0;
				float z = 0;

				float x1 = 0;
				float y1 = 0;
				float z1 = 0;
				//Первая напрявляющая меньшая
				memcpy_s(&x, 4, filereader.Read(i, 4), 4);
				memcpy_s(&y, 4, filereader.Read(i + 4, 4), 4);
				memcpy_s(&z, 4, filereader.Read(i + 8, 4), 4);
				//Сторая направлющая большая
				memcpy_s(&x1, 4, filereader.Read(i + 12, 4), 4);
				memcpy_s(&y1, 4, filereader.Read(i + 16, 4), 4);
				memcpy_s(&z1, 4, filereader.Read(i + 20, 4), 4);
				//Сохраняем направляющую
				pillars.push_back(std::vector < std::vector<float>>
				{
					std::vector<float> {x + xshift, y + yshift, z},
						std::vector<float> {x1 + xshift, y1 + yshift, z1} });

			}

			*xstart = pillars[0][0][0];
			*ystart = pillars[0][0][1];
			*dx = pillars[1][0][0] - pillars[0][0][0];
			*dy = pillars[(int)xc + (int)1][0][1] - pillars[xc][0][1];
			*plrs = pillars;

			filereader.~BinaryFileRead();
			//Читаем файлы
			//auto pporo = Read(poro);//считываем пористость
			//auto voll = Read(vol);//считываем обьем
			//проверка необязательных полей
			//std::vector<char> ssoil;
			//std::vector<char> sso;
			//std::vector<char> actnumm;
			auto poro_size = GetFileSize(poro);
			auto voll_size = GetFileSize(vol);
			long long soil_size = 0;
#ifdef USE_SO
			long long sso_size = 0;
#endif
			long long actnum_size = 0;
			if (*soil != '0x0') //проверка на терминальную строку
				soil_size = GetFileSize(soil);//считываем нач насыщенность
#ifdef USE_SO
			if (*so != '0x0') //проверка на терминальную строку
				sso_size = GetFileSize(so);//считываем текущая насыщенность
#endif
			if (*actnum != '0x0') //проверка на терминальную строку
				actnum_size = GetFileSize(actnum);//считываем включенные ячейки

			if (poro_size > 0 && voll_size > 0 && soil_size > 0)
			{
				BinaryFileRead PoroReader;
				PoroReader.OpenFile(poro);

				BinaryFileRead VolReader;
				VolReader.OpenFile(vol);

				BinaryFileRead SoilReader;
				if (soil_size > 0)
					SoilReader.OpenFile(soil);
#ifdef USE_SO
				BinaryFileRead SoReader;
				if (sso_size > 0)
					SoReader.OpenFile(so);
#endif
				BinaryFileRead ActnumReader;
				if (actnum_size > 0)
					ActnumReader.OpenFile(actnum);

				std::string sign1(PoroReader.Read(0, 16), 16);
				std::string sign5(VolReader.Read(0, 16), 16);
				//устанавливаем необязательные подписи
				std::string sign2; //soil
				if (soil_size > 0)
					sign2 = std::string(SoilReader.Read(0, 16), 16);
				std::string sign3; //actnum
				if (actnum_size > 0)
					sign3 = std::string(ActnumReader.Read(0, 16), 16);

				if (sign1 == "KPFUBOIL    GRID" && sign5 == "KPFUBOIL    GRID"
					&& sign2 == "KPFUBOIL    GRID") //проверяем 
				{
					//Получаем запасы
					int pindex = 0;
					std::vector<std::vector<float>> zap;
					std::vector<float> StartZap;
					float avg = 0;
					float avg_b = 0;
					for (long k = 0; k < zc; k++)
					{
						for (long j = 0; j < yc; j++)
						{
							if (zap.begin() + j == zap.end()) //добавляем ячейки  только при необходимости
								zap.push_back(std::vector<  float>());
							for (int i = 0; i < xc; i++)
							{
								if (zap[j].begin() + i == zap[j].end())//добавляем ячейки  только при необходимости
									zap[j].push_back(0);
								if (StartZap.begin() + (long)j * xc + (long)i == StartZap.end())
									StartZap.push_back(0);
								float actnum_val = 1;
								if (actnum_size > 0 && sign3 == "KPFUBOIL    GRID") //если актнум есть и правильный, то чекаем его
									memcpy_s(&actnum_val, 4, ActnumReader.Read(32 + pindex, 4), 4);
								if (abs(actnum_val - 1.0) < 1e-1) //проверка на включенность ячейки
								{

									float SaturationBegin = 0;
									float SaturationCurrent = 0;
									float Porosition = 0;
									float Volume = 0;

									memcpy_s(&Porosition, 4, PoroReader.Read((long)32 + pindex, 4), 4);
									memcpy_s(&Volume, 4, VolReader.Read((long)32 + pindex, 4), 4);

									if (soil_size > 0)
										memcpy_s(&SaturationBegin, 4, SoilReader.Read((long)32 + pindex, 4), 4);
#ifdef USE_SO
									if (sso_size > 0)
										memcpy_s(&SaturationCurrent, 4, SoReader.Read((long)32 + pindex, 4), 4);
#endif
									zap[j][i] += Porosition * SaturationCurrent * density * Volume;
									StartZap[j * xc + (long)i] += Porosition * SaturationBegin * density * Volume;
								}
								pindex += 4;
							}
						}
					}
					*average = avg / (xc * yc);
					*b_average = avg_b / (xc * yc);
					*b_sat = StartZap;
					PoroReader.~BinaryFileRead();
					VolReader.~BinaryFileRead();
					SoilReader.~BinaryFileRead();
					/*SoReader.~BinaryFileRead();*/
					ActnumReader.~BinaryFileRead();
					return zap;
				}
				std::cout << "Невозможно расчитать запасы\nФайл PORO или VOLUME или SOIL/SO поврежден\n";
				return std::vector < std::vector<float>>();
			}
			std::cout << "Невозможно расчитать запасы\nФайл PORO или VOLUME или SOIL/SO недоступен для чтения\n";
			return std::vector < std::vector<float>>();
		}
		std::cout << "Невозможно расчитать запасы\nФайл COORD поврежден\n";
		return std::vector < std::vector<float>>();
	}
	std::cout << "Невозможно расчитать запасы\nФайл COORD недоступен для чтения\n";
	return std::vector < std::vector<float>>();
}

std::map<std::string, std::string> BinaryFileRead::ReadGRDECLModels(const char* path, double* xshift, double* yshifth)
{
	auto file = Read(path); //читаем файл
	std::map<std::string, std::string> out;
	if (file.size() > 0)
	{
		std::string sign(&file[0], 16);
		if (sign == "KPFUBOIL  GRDECL") //проверяем сигнатуру
		{
			//загружаем смешение по x
			memcpy_s(xshift, 8, &file[32], 8);
			memcpy_s(yshifth, 8, &file[40], 8);
			//загружаем guid
			std::vector<char> Buffer;
			std::vector<std::string> sBuffer;
			for (int i = 48; i < file.size(); i++)
			{
				if (file[i] != '|')
				{
					Buffer.push_back(file[i]); //все символы собираем в один массив
				}
				else {
					sBuffer.push_back(std::string(Buffer.begin(), Buffer.end())); //на разделителе парсим строку
					Buffer.clear();
					if (sBuffer.size() == 2) //если строка собралась, то добавляем её в выходной массив
					{
						out.insert({ sBuffer[0], sBuffer[1] });

						sBuffer.clear();
					}
				}
			}
			sBuffer.push_back(std::string(Buffer.begin(), Buffer.end())); //для последней строки
			out.insert({ sBuffer[0], sBuffer[1] });
			return out;
		}
	}
	return out;
}


std::map<std::string, std::string> BinaryFileRead::ReadGRDECLModels(const char* path, double* xshift, double* yshifth, int* nx, int* ny, int* nz)
{
	auto file = Read(path); //читаем файл
	std::map<std::string, std::string> out;
