void WellDataHandler::GeoChemData::Push(std::wstring path_to_gc)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_gc);
	std::vector<std::vector<std::wstring>> data = std::move(parser.Read());
	
	for (const auto& line : data)
	{
		std::wstring name = line[1];
		std::map<std::wstring, float> ldata;
		ldata[L"p/p"] = stof(line[0]);
		ldata[L"part_number"] = stof(line[2]);
		ldata[L"time"] = PathUtils::Utils::ConvertDateToExcelDate(line[3]);
		ldata[L"methane"] = stof(line[4]);
		ldata[L"ethane"] = stof(line[5]);
		ldata[L"propane"] = stof(line[6]);
		ldata[L"ibutane"] = stof(line[7]);
		ldata[L"butane"] = stof(line[8]);
		ldata[L"ipentane"] = stof(line[9]);
		ldata[L"pentane"] = stof(line[10]);
		ldata[L"gexane"] = stof(line[11]);
		ldata[L"ibut/but"] = stof(line[12]);
		ldata[L"ipen/pen"] = stof(line[14]);
		ldata[L"ml_isobutane"] = stof(line[14]);
		ldata[L"ml_butane"] = stof(line[15]);
		ldata[L"ml_isobutane_butane"] = stof(line[16]);
		Container[name].push_back(ldata);
		WellsName[name] = 0;
	}
	Optimize();
}

