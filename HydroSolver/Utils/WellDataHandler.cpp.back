void WellDataHandler::FECData::Push(std::wstring path_to_fec)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_fec);
	size_t size = 0;
	std::unique_ptr<std::unique_ptr<std::unique_ptr<wchar_t[]>[]>[]> data = std::move(parser.ReadA(size));
	
	/*int line_counter = 0;*/
	for (int i = 1; i < size; i++)
	{
		//if (line.size())
		//{
		//	if (line_counter) //пропускаем первую строку
		//	{
		auto line = std::move(data[i]);
		if (*line[5].get() != L'\x0')
		{
			std::wstring name(line[1].get());
			std::map<std::wstring, float> ldata;
			ldata[L"time"] = PathUtils::Utils::ConvertDateToExcelDate(std::wstring(line[5].get()));
			Container[name].push_back(ldata);
		}
		line.reset();
		/*	}
		}
		line_counter++;*/
	}
	data.reset();
	Optimize();
}

std::vector<std::wstring> WellDataHandler::FECData::GetWellsPerPeriod(int start, int stop)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	std::vector<std::wstring> out;
	for (const auto& wd : Container)
	{
		for (const auto& d : wd.second)
		{
			if (d.at(L"time") >= start && d.at(L"time") <= stop)
			{
				out.push_back(wd.first);
			}
		}
	}
	return out;
}

void WellDataHandler::AnomData::Push(std::wstring path, std::wstring name)
{
}

void WellDataHandler::AnomData::Push(std::wstring path_to_anom)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_anom);
	size_t size = 0;
	std::unique_ptr<std::unique_ptr<std::unique_ptr<wchar_t[]>[]>[]> data = std::move(parser.ReadA(size));

	wchar_t* stopscan;
	for (size_t i = 1; i < size; i++)
	{
		auto line = std::move(data[i]);

		std::wstring name(line[0].get());
		std::map<std::wstring, float> ldata;
		ldata[L"time"] = PathUtils::Utils::ConvertDateToExcelDate(line[2].get());
		// anomaly input:
		// 1 - ложная аномалия
		// 2 - геохимический след целиков
		// 3 - тип аномалии не определен
		ldata[L"type"] = wcstof(DataReader::ReplaceCommaWithDot(line[3].get()).c_str(), &stopscan);
		ldata[L"batch_number"] = wcstof(DataReader::ReplaceCommaWithDot(line[1].get()).c_str(), &stopscan);
		Container[name].push_back(ldata);

		line.reset();
	}
	data.reset();
	Optimize();
}



void WellDataHandler::KH_MerLayeredData::Push(
	MerData& mer,
	GISData& gis,
	PerfData& perf,
	std::vector<std::wstring> LayersName,
	std::vector<std::wstring> WellNames)
{
	for (const auto& ln : LayersName)
	{
		Mers.insert({ ln, std::make_shared<MerData>() });
	}
	std::atomic_int th_counter = 0;
	int ref_th_counter = 0;
	std::mutex MersMutex;
	std::vector<bool> th_status(16);

	auto lambda_divide_prod = [](
		std::wstring wn,
		std::vector<std::wstring>& _LayersName,
		std::map<std::wstring, std::shared_ptr<MerData>>& _Mers,
		std::mutex& _MersMutex,
		MerData& _mer,
		GISData& _gis,
		PerfData& _perf,
		std::atomic_int& sync,
		std::vector<bool>& _th_status,
		int id)
	{
		//делим
		auto div = DataHandleUtils::DivideProduction(wn, _mer, _gis, _perf, _LayersName);
		//блокируем поток и заполняем
		std::lock_guard<std::mutex> lock(_MersMutex);
		for (const auto& ln : _LayersName)
		{
			for (const auto& data : div[ln])
			{
				_Mers[ln]->PushManualy(wn, data);
			}
		}
		//сообщаем о готовности
		sync++;
		//освобождаем ячейку под поток
		_th_status[id] = false;
	};

	for (const auto& wn : WellNames)
	{
		//ищем свободную ячейку
		std::lock_guard<std::mutex> lock(MersMutex);
		bool exit = false;
		while (!exit)
		{
			for (int i = 0; i < th_status.size(); i++)
			{
				//если ее находим
				if (!th_status[i])
				{
					//запускаем поток деления
					std::thread div_thread(
						lambda_divide_prod,
						wn,
						std::ref(LayersName),
						std::ref(Mers),
						std::ref(MersMutex),
						std::ref(mer),
						std::ref(gis),
						std::ref(perf),
						std::ref(th_counter),
						std::ref(th_status),
						i);
					//сообщаем о потоке
					ref_th_counter++;
					th_status[i] == true;
					//запускаем поток
					div_thread.detach();
					//выходим из цикла
					exit = true;
					break;
				}
			}
			//если все ячейки потоков заняты, то ожидаем
			if (!exit)
				std::this_thread::sleep_for(std::chrono::microseconds(10));
		}
	}
	//ждем все потоки
	while (ref_th_counter != th_counter)
		std::this_thread::sleep_for(std::chrono::microseconds(10));

	for (auto& mer : Mers)
	{
		mer.second->ManualOptimize();
	}
}

void WellDataHandler::RaschData::Push(std::wstring path, std::wstring name)
{
}

void WellDataHandler::RaschData::Push(std::wstring path_to_rasch)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_rasch);
	std::vector<std::vector<std::wstring>> data = std::move(parser.Read());
	
	for (const auto& line : data)
	{
		if (line.size() == 7)
		{

			std::wstring name = line[0];
			std::map<std::wstring, float> ldata;
			ldata[L"Д0"] = stoi(line[3]);
			ldata[L"Д кынов."] = stoi(line[3]);
			ldata[L"Д1А"] = stoi(line[4]);
			ldata[L"Д1Б"] = stoi(line[5]);
			ldata[L"Д1ВГД"] = stoi(line[6]);
			Container[name].push_back(ldata);
		}


	}
	Optimize();
}

void WellDataHandler::WellCoordData::Push(std::wstring path, std::wstring name)
{
}

void WellDataHandler::WellCoordData::Push(std::wstring path_to_pp)
{
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_pp);
	size_t size = 0;
	std::unique_ptr<std::unique_ptr<std::unique_ptr<wchar_t[]>[]>[]> data = std::move(parser.ReadA(size));
	

	wchar_t* stopscan;
	/*int cntr = 0;*/
	for (int i = 1; i < size; i++)
	{
		auto line = std::move(data[i]);
		/*if (wcscmp(line[1].get(), L"all") != 0)
			break;*/
		//if (!cntr)
		//{
		//	cntr++;
		//	continue;
		//} //пропускаем первую строку
		std::wstring name(line[0].get());
		std::map<std::wstring, float> ldata;
		ldata[L"X"] = wcstof(DataReader::ReplaceCommaWithDot(line[2].get()).c_str(), &stopscan);
		ldata[L"Y"] = wcstof(DataReader::ReplaceCommaWithDot(line[3].get()).c_str(), &stopscan);
		Container[name].push_back(ldata);
		//Сохраняем имена
		if (std::find(WellsName.begin(), WellsName.end(), name) == WellsName.end())
		{
			WellsName.push_back(name);
		}
		line.reset();
	}
	data.reset();
	Optimize();
}

void WellDataHandler::IData::Optimize()
{
	//std::lock_guard<std::mutex> lock(DataAccessMutex);
	for (auto& vector : Container)
	{
		vector.second.shrink_to_fit();
	}
	for (auto& vector : StringContainer)
	{
		vector.second.shrink_to_fit();
	}
}
