void WellDataHandler::GISData::Push(std::wstring path_to_gis_file)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_gis_file);
	size_t size = 0;
	std::unique_ptr<std::unique_ptr<std::unique_ptr<wchar_t[]>[]>[]> data = std::move(parser.ReadA(size));
	
	/*int line_counter = 0;*/
	for (int i = 1; i < size; i++)
	{
		/*if (!line_counter)
		{
			line_counter++;
			continue;
		}*/
		wchar_t* stopscan;

		auto line = std::move(data[i]);
		if (/*line[1].get() != L"Н/Д" && line[2].get() != L"Н/Д"*/
			wcscmp(line[1].get(), L"Н/Д") != 0
			&& wcscmp(line[2].get(), L"Н/Д") != 0
			&& (*line[1].get() == L'Д' || *line[1].get() == L'д') //берем только пласты с индексом Д
			)
		{
			std::wstring name(line[0].get());
			std::map<std::wstring, float> ldata;
			ldata[L"layer_start"] = wcstof(DataReader::ReplaceCommaWithDot(line[3].get()).c_str(), &stopscan);
			ldata[L"layer_stop"] = wcstof(DataReader::ReplaceCommaWithDot(line[5].get()).c_str(), &stopscan);
			ldata[L"layer_height"] = wcstof(DataReader::ReplaceCommaWithDot(line[4].get()).c_str(), &stopscan);
			ldata[L"porosity"] = /*(line[18].get() != L'\x0') ?*/ wcstof(DataReader::ReplaceCommaWithDot(line[18].get()).c_str(), &stopscan) / 100 /*: 0*/;
			ldata[L"permability"] = /*(line[19].get() != L'\x0') ?*/ wcstof(DataReader::ReplaceCommaWithDot(line[19].get()).c_str(), &stopscan) / 1000 /*: 0*/;
			ldata[L"oil_saturation"] = /*(line[20].get() != L'\x0') ?*/ wcstof(DataReader::ReplaceCommaWithDot(line[20].get()).c_str(), &stopscan) / 100 /*: 0*/;
			ldata[L"is_collector"] = (!wcscmp(line[10].get(), L"Да")) ? 1 : 0;
			ldata[L"saturated_height"] =/* (line[34].get() != L'\x0') ?*/ wcstof(DataReader::ReplaceCommaWithDot(line[34].get()).c_str(), &stopscan) /*: 0*/; //нефтенасышенная толщина
			Container[name].push_back(ldata);
			std::map<std::wstring, std::wstring> lsdata;
			lsdata[L"layer_name"] = std::wstring(line[1].get());
			lsdata[L"in_layer_name"] = std::wstring(line[2].get());
			StringContainer[name].push_back(lsdata);
		}
		line.reset();
	}
	data.reset();
	Optimize();
}

void WellDataHandler::MerData::Push(std::wstring path, std::wstring name)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto data = WellDataHandler::DataReader::Read(path);
	for (const auto& line : data)
	{
		std::map<std::wstring, float> ldata;
		ldata[L"time"] = line[0].Value;
		ldata[L"oil"] = line[9].Value;
		ldata[L"water"] = line[10].Value;
		ldata[L"pump_water"] = line[20].Value;
		ldata[L"worked_time"] = line[6].Value;
		ldata[L"colection_time"] = line[7].Value;
		ldata[L"type"] = (ldata[L"pump_water"] == 0) ? 1 : 0; //1 - нефть 0 - наг 
		Container[name].push_back(ldata);
		//накопленные значения
		CumOil[name] += (ldata[L"oil"] > 0) ? ldata[L"oil"] : 0;
		CumWater[name] += (ldata[L"water"] > 0) ? ldata[L"water"] : 0;
		CumPumpWater[name] += (ldata[L"pump_water"] > 0) ? ldata[L"pump_water"] : 0;
	}
}

void WellDataHandler::MerData::Push(std::wstring path_to_mer)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	auto parser = UniversalSCParser::UTF8SVParser(path_to_mer);
	size_t size = 0;
	std::unique_ptr<std::unique_ptr<std::unique_ptr<wchar_t[]>[]>[]> data = std::move(parser.ReadA(size));
	
	wchar_t* stopstring;

	for (size_t i = 1; i < size; i++)
	{
		auto line = std::move(data[i]);

		std::wstring name(line[0].get());
		std::map<std::wstring, float> ldata;
		std::map<std::wstring, std::wstring> sdata;

		sdata[L"layers"] = line[2].get();


		ldata[L"time"] = PathUtils::Utils::ConvertDateToExcelDate(std::wstring(line[1].get()));

		if (wcscmp(line[3].get(), L"НЕФ") == 0)
			ldata[L"type"] = 1;
		else if (wcscmp(line[3].get(), L"НАГ") == 0)
			ldata[L"type"] = -1;
		else
			ldata[L"type"] = 0;

		if (ldata[L"type"] == 1)
		{
			ldata[L"oil_v"] = wcstof(DataReader::ReplaceCommaWithDot(line[16].get()).c_str(), &stopstring); // stof(line[17]);
			ldata[L"water_v"] = wcstof(DataReader::ReplaceCommaWithDot(line[17].get()).c_str(), &stopstring); // stof(line[18]);
			ldata[L"oil_m"] = wcstof(DataReader::ReplaceCommaWithDot(line[10].get()).c_str(), &stopstring) * 1000; // stof(line[17]);
			ldata[L"water_m"] = wcstof(DataReader::ReplaceCommaWithDot(line[11].get()).c_str(), &stopstring) * 1000; // stof(line[18]);
		}
		else if (ldata[L"type"] == -1)
		{
			ldata[L"oil_v"] = 0.0;
			ldata[L"water_v"] = -wcstof(DataReader::ReplaceCommaWithDot(line[21].get()).c_str(), &stopstring); // -stof(line[21]);
			ldata[L"oil_m"] = 0.0;
			ldata[L"water_m"] = -wcstof(DataReader::ReplaceCommaWithDot(line[21].get()).c_str(), &stopstring)*1000; // -stof(line[21]);
		}
		else
		{
			ldata[L"oil_v"] = 0.0;
			ldata[L"water_v"] = 0.0;
			ldata[L"oil_m"] = 0.0;
			ldata[L"water_m"] = 0.0;
		}
		line.reset();

		Container[name].push_back(std::move(ldata));
		StringContainer[name].push_back(std::move(sdata));
	}
	data.reset();
	Optimize();
}

void WellDataHandler::MerData::PushManualy(
	std::wstring Name,
	std::map<std::wstring, float> Data)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	Container[Name].push_back(Data);
	CumOil[Name] += (Data[L"oil"] > 0) ? Data[L"oil"] : 0;
	CumWater[Name] += (Data[L"water"] > 0) ? Data[L"water"] : 0;
	CumPumpWater[Name] += (Data[L"pump_water"] > 0) ? Data[L"pump_water"] : 0;

	SumPumpTime[Name] += (
		!Data[L"type"]
		&&
		Data[L"is_work"]) ? Data[L"worked_time"] / 730 : 0;

	SumIdleTime[Name] += Data[L"idle_time"] / 730;

	float wtrc = Data[L"water"] / (Data[L"water"] + Data[L"oil"]);
	if (!std::isnormal(wtrc))
		wtrc = -1;//-1 чтобы не в миксед тайм не попадали моменты когда скважина вообще не работала

	SumMixedTime[Name] += (
		Data[L"is_work"]
		&&
		Data[L"type"]
		&&
		wtrc >= 0.2) ? Data[L"worked_time"] / 730 : 0;

	SumDryTime[Name] += (
		Data[L"is_work"]
		&&
		Data[L"type"]
		&&
		wtrc <= 0.2) ? Data[L"worked_time"] / 730 : 0;

	CumDryOil[Name] += (
		Data[L"is_work"]
		&&
		Data[L"type"]
		&&
		wtrc <= 0.2) ? Data[L"oil"] : 0;
}

float WellDataHandler::MerData::GetValue(int id, std::wstring name)
{
	//блокируем поток для чтения
	std::lock_guard<std::mutex> lock(DataAccessMutex);
	switch (id)
	{
	case 0:
		return CumOil[name];
		break;
	case 1:
		return CumWater[name];
		break;
	case 2:
		return CumPumpWater[name];
		break;
	case 3:
		return CumDryOil[name];
		break;
	case 4:
		return SumPumpTime[name];
		break;
	case 5:
		return SumIdleTime[name];
		break;
	case 6:
		return SumMixedTime[name];
		break;
	case 7:
		return SumDryTime[name];
		break;
	default:
		return 0;
		break;
	}
	return 0;
}




void WellDataHandler::GDISData::Push(std::wstring path, std::wstring name)
